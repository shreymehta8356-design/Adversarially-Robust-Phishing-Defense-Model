{
  "uid": "phishguard-ops",
  "title": "PhishGuard - operations",
  "tags": [
    "phishguard",
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Service up",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "up{job=\"phishguard-api\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Messages assessed (1h)",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(phishguard_scans_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Assessment p95 (ms)",
      "description": "Acceptance gate G7 requires this to stay at or below 150 ms.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(phishguard_scan_duration_ms_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Routed to analysts",
      "description": "Share of traffic landing in the REVIEW band. Sustained high values mean the queue stops being read.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.4
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(phishguard_scans_total{band=\"REVIEW\"}[30m])) / clamp_min(sum(rate(phishguard_scans_total[30m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Model version",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "options": {
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "phishguard_model_info",
          "refId": "A",
          "legendFormat": "{{model_version}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Decisions by band",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ALLOW"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "REVIEW"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "BLOCK"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (band) (rate(phishguard_scans_total[5m]))",
          "legendFormat": "{{band}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Assessment latency percentiles",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(phishguard_scan_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(phishguard_scan_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(phishguard_scan_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Score distribution over time",
      "description": "The earliest available drift signal: a shift in the shape of this histogram precedes a measurable accuracy change.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (le) (rate(phishguard_score_bucket[10m]))",
          "legendFormat": "<= {{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Behavioural context availability",
      "description": "The modality ablation shows what the system loses when the gateway supplies no sender history.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (available) (rate(phishguard_behavioral_context_total[10m]))",
          "legendFormat": "context {{available}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Analyst feedback",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (label) (increase(phishguard_feedback_total[1h]))",
          "legendFormat": "{{label}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rejected requests",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(phishguard_auth_failures_total[5m]))",
          "legendFormat": "auth: {{reason}}",
          "refId": "A"
        },
        {
          "expr": "rate(phishguard_rate_limited_total[5m])",
          "legendFormat": "rate limited",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Adversarial probes",
      "description": "A probe that evades the deployed model is a finding: capture the message and re-run the evaluation.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (evaded) (increase(phishguard_adversarial_probes_total[1h]))",
          "legendFormat": "evaded={{evaded}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cases waiting",
      "description": "Open, in review or escalated. Each is a message a person has been promised will be looked at.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "expr": "sum(phishguard_queue_depth{state=~\"open|in_review|escalated\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cases past their service level",
      "description": "P1 = 1 h, P2 = 4 h, P3 = 24 h. Anything here needs an analyst now.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "phishguard_queue_overdue",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Median time to resolve (24h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(phishguard_case_resolution_seconds_bucket[24h])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "User reports (24h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 27
      },
      "targets": [
        {
          "expr": "sum(increase(phishguard_cases_opened_total{origin=\"user_report\"}[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Review queue depth by state",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "expr": "sum by (state) (phishguard_queue_depth)",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Time per pipeline stage (p95)",
      "description": "From request traces: which stage a slow request spent its time in. Stages: assess, member.*, fusion, explain, audit.write, queue.open.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(phishguard_stage_duration_ms_bucket[5m])))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    }
  ]
}
