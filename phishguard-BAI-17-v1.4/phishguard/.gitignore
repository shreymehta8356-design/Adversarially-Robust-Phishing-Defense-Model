# Secrets and local configuration ------------------------------------------
# The acceptance gate forbids committing secrets or personal data; these lines
# are the mechanical half of that promise and the CI secret scan is the other.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
api_keys.txt

# Data and models ----------------------------------------------------------
# Corpora may contain real recipients' addresses and are licensed individually.
# Models and the audit database are build outputs, reproducible from the CLI.
# The generated reports ARE committed: they are the evidence the documents
# quote, and they hold no message content. Models, databases and anything
# produced from a real corpus are not.
artifacts/*
!artifacts/reports/
artifacts/reports/triage.csv
artifacts/reports/corpus-audit.json
artifacts-*/
data/
*.mbox
*.eml
*.db
*.db-wal
*.db-shm
*.joblib
*.pkl
*.onnx
mlruns/

# Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

