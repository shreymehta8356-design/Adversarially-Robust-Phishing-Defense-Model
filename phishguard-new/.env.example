# PhishGuard configuration.
#
#   cp .env.example .env
#
# Every value is optional; the defaults are safe for local development and
# unsafe for anything else. The two that MUST change before this service is
# reachable by anyone but you are PG_API_KEYS and PG_PSEUDONYMIZATION_SALT.

# --------------------------------------------------------------- general ---
# dev | test | prod. In prod the service refuses to start without PG_API_KEYS.
PG_ENVIRONMENT=dev
PG_LOG_LEVEL=INFO
PG_LOG_FORMAT=json
PG_RANDOM_SEED=20260907
PG_ARTIFACTS_DIR=./artifacts

# ------------------------------------------------------------- security ---
# Comma-separated role:key pairs. Generate with:
#   python -c "import secrets;print('analyst:pg_an_'+secrets.token_urlsafe(32))"
#   python -c "import secrets;print('admin:pg_ad_'+secrets.token_urlsafe(32))"
# PG_API_KEYS=analyst:REPLACE_ME,admin:REPLACE_ME

# Salt for the non-reversible sender identifiers in the audit trail. Changing it
# breaks correlation with older rows, so set it once per deployment and keep it.
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
PG_PSEUDONYMIZATION_SALT=change-me-in-production

PG_RATE_LIMIT_PER_MINUTE=120
PG_MAX_BODY_BYTES=1000000

# --------------------------------------------------------------- service ---
PG_API_HOST=0.0.0.0
PG_API_PORT=8000
PG_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Days of audit history retained. Swept at startup.
PG_AUDIT_RETENTION_DAYS=90

# ------------------------------------------------------ decision policy ---
# score <  review  -> ALLOW
# review <= score < block -> REVIEW (queued for an analyst)
# score >= block   -> BLOCK
#
# Raising PG_REVIEW_THRESHOLD reduces analyst workload and increases the number
# of phishing messages delivered silently. Lowering PG_BLOCK_THRESHOLD blocks
# more phishing and more legitimate mail. Both are policy, not model, decisions.
PG_REVIEW_THRESHOLD=0.40
PG_BLOCK_THRESHOLD=0.80

# ----------------------------------------------------------------- model ---
PG_ENABLED_MEMBERS=["rules","engineered","charngram","wordtfidf"]
# Requires the transformer extra: pip install '.[transformer]'
PG_USE_TRANSFORMER=false
PG_TRANSFORMER_NAME=distilbert-base-uncased
# Adversarially augmented copies added per phishing training example (D-ADVTRAIN)
PG_ADV_TRAIN_ENABLED=true
PG_ADV_TRAIN_MULTIPLIER=1

# ------------------------------------------------------------------ data ---
PG_SYNTHETIC_N_TRAIN=9000
PG_SYNTHETIC_N_TEST=3000
PG_SYNTHETIC_PHISH_RATIO=0.42
PG_NEAR_DUPLICATE_THRESHOLD=0.85

# ----------------------------------------------------------- adversarial ---
PG_ATTACK_BUDGET=10
PG_ATTACK_SEED=7

# ------------------------------------------------------ acceptance gates ---
# A build that misses any of these fails `phishguard evaluate` with exit code 1.
PG_GATE_MACRO_F1=0.90
PG_GATE_PR_AUC=0.93
PG_GATE_MAX_FPR=0.02
PG_GATE_MAX_ECE=0.08
PG_GATE_MAX_ROBUSTNESS_DROP=0.15
PG_GATE_MAX_ATTACK_SUCCESS_RATE=0.35
PG_GATE_P95_LATENCY_MS=150
